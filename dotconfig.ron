DotConfig(
    symlinks: [
        Location(
            from: "links/ZSH/zshrc",
            to: Os(
                macos: "%HOME%/.zshrc",
                linux: "%HOME%/.zshrc",
                windows: "",
            ),
        ),
        Location(
            from: "links/.ideavimrc",
            to: String("%HOME%/.ideavimrc"),
        ),
        Location(
            from: "links/zed",
            to: Os(
                macos: "%UNIX_CONFIG%/zed",
                linux: "%CONFIG%/zed",
                windows: "%DATA%/Zed",
            ),
        ),
        Location(
            from: "links/opencode/opencode.json",
            to: Os(
                macos: "%UNIX_CONFIG%/opencode/opencode.json",
                linux: "%CONFIG%/opencode/opencode.json",
                windows: "%HOME%/.config/opencode/opencode.json",
            ),
        ),
        Location(
            from: "links/opencode/cli.json",
            to: Os(
                macos: "%UNIX_CONFIG%/opencode/cli.json",
                linux: "%CONFIG%/opencode/cli.json",
                windows: "%HOME%/.config/opencode/cli.json",
            ),
        ),
        Location(
            from: "links/ghostty",
            to: Os(
                macos: "%CONFIG%/com.mitchellh.ghostty",
                linux: "%UNIX_CONFIG%/ghostty",
                windows: "",
            ),
        ),
        Location(
            from: "links/nvim",
            to: Os(
                macos: "%UNIX_CONFIG%/nvim",
                linux: "%CONFIG%/nvim",
                windows: "%DATA_LOCAL%/nvim",
            ),
        ),
        Location(
            from: "links/Sublime/User",
            to: Os(
                macos: "%HOME%/Library/Application Support/Sublime Text/Packages/User",
                linux: "",
                windows: "",
            ),
        ),
        Location(
            from: "links/starship/starship.toml",
            to: Os(
                macos: "%UNIX_CONFIG%/starship.toml",
                linux: "%CONFIG%/starship.toml",
                windows: "%HOME%/starship.toml",
            ),
        ),
        Location(
            from: "links/hypr",
            to: Os(
                macos: "",
                linux: "%CONFIG%/hypr",
                windows: "",
            ),
        ),
        Location(
            from: "links/noctalia",
            to: Os(
                macos: "",
                linux: "%CONFIG%/noctalia",
                windows: "",
            ),
        ),
        Location(
            from: "links/skills",
            to: Os(
                macos: "%HOME%/.codex/skills",
                linux: "%HOME%/.codex/skills",
                windows: "",
            ),
        ),
    ],
    copies: [
        Location(
            from: "links/Powershell",
            to: Os(
                macos: "",
                linux: "",
                windows: "%DOCUMENTS%/Powershell",
            ),
        ),
        Location(
            from: "links/fonts",
            to: Os(
                macos: "%HOME%/Library/Fonts",
                linux: "%HOME%/.local/share/fonts",
                windows: "%DATA_LOCAL%/Microsoft/Windows/Fonts",
            ),
        ),
    ],
    dependencies: [
        Cargo(
            name: "starship",
            git: None,
            windows: true,
        ),
        Cargo(
            name: "exa",
            git: None,
            windows: false,
        ),
        Cargo(
            name: "ripgrep",
            git: None,
            windows: true,
        ),
        Cargo(
            name: "ru",
            git: None,
            windows: true,
        ),
        Cargo(
            name: "cargo-update",
            git: None,
            windows: true,
        ),
        Bash(
            name: "codex",
            command: "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
            binary: Some("codex"),
            directory: None,
        ),
        Bash(
            name: "bun",
            command: "curl -fsSL https://bun.sh/install | bash",
            binary: Some("bun"),
            directory: None,
        ),
        Bash(
            name: "opencode",
            command: "curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path",
            binary: Some("opencode"),
            directory: None,
        ),
        Bash(
            name: "vite-plus",
            command: "curl -fsSL https://vite.plus | VP_NODE_MANAGER=yes VP_PM_MANAGER=no VP_PNPM_MANAGER=yes bash",
            binary: Some("vp"),
            directory: None,
        ),
        Bash(
            name: "oh-my-zsh",
            command: "curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh | RUNZSH=no KEEP_ZSHRC=yes bash",
            binary: None,
            directory: Some("%HOME%/.oh-my-zsh"),
        ),
    ],
    git_aliases: [
        GitAlias(
            name: "st",
            command: "status",
        ),
        GitAlias(
            name: "co",
            command: "checkout",
        ),
        GitAlias(
            name: "ci",
            command: "commit",
        ),
    ],
)
