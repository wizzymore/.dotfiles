export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

plugins=(git laravel)

source $ZSH/oh-my-zsh.sh

export PATH=$PATH:$HOME/go/bin
export EDITOR="nvim"

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

if [[ `uname` == Darwin ]]; then
  # Sublime Text
  export PATH="$PATH:/Applications/Sublime Text.app/Contents/SharedSupport/bin"

  export PATH="/usr/local/share/dotnet:$PATH"

  # MacOS 27 beta crash fix for php
  export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

  export LDFLAGS="-L$(brew --prefix)/lib"
  export CPPFLAGS="-I$(brew --prefix)/include/"

  # Composer
  export PATH="$HOME/.composer/vendor/bin:$PATH"

  export VCPKG_ROOT="$HOME/vcpkg"
  export PATH="$VCPKG_ROOT:$PATH"
  export ODIN_ROOT=$HOME/src/odin/Odin

case ":$PATH:" in
  *":$HOME/Library/Application Support/io.yerd.Yerd/bin:"*) ;;
  *) export PATH="$HOME/Library/Application Support/io.yerd.Yerd/bin:$PATH" ;;
esac
export PHPRC="$HOME/Library/Application Support/io.yerd.Yerd/php-cli.ini"
else

# >>> yerd PATH >>>
case ":$PATH:" in
  *":$HOME/.local/share/yerd/bin:"*) ;;
  *) export PATH="$HOME/.local/share/yerd/bin:$PATH" ;;
esac
export PHPRC="$HOME/.local/share/yerd/php-cli.ini"
# <<< yerd PATH <<<

  export ODIN_ROOT=/usr/lib/odin
  export PATH="$HOME/.config/emacs/bin:$PATH"
fi

export PATH=$PATH:$ODIN_ROOT

alias wip="git add .; git commit -m \"WIP\""
alias gip="git push"
alias gis="git status"
alias vim="nvim"
alias ls="exa"
alias la="ls -la"
alias grep="rg"
alias ta="tmux a"

TIMEFMT='%J   %U  user %S system %P cpu %*E total'$'\n'\
'avg shared (code):         %X KB'$'\n'\
'avg unshared (data/stack): %D KB'$'\n'\
'total (sum):               %K KB'$'\n'\
'max memory:                %M KB'$'\n'\
'page faults from disk:     %F'$'\n'\
'other page faults:         %R'

. "$HOME/.cargo/env"

if (( ${+WSLENV} )); then
  alias ssh=ssh.exe
fi

# Let this be last
eval "$(starship init zsh)"

export PATH="$HOME/.local/bin:$PATH"

# Add RVM to PATH for scripting. Make sure this is the last PATH variable change.
export PATH="$PATH:$HOME/.rvm/bin"

# Local secrets (kept outside the dotfiles repository).
[[ -f "$HOME/.secrets.zsh" ]] && source "$HOME/.secrets.zsh"

# Vite+ bin (https://viteplus.dev)
. "$HOME/.config/vite-plus/env"

# >>> Codex installer >>>
export PATH="$HOME/.local/bin:$PATH"
# <<< Codex installer <<<

# Added by LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"
# End of LM Studio CLI section
