{
  "$schema": "https://opencode.ai/v2/cli.json",
  "session": {
    "verbosity": "medium",
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": false,
    "tps": true,
    "new_location": "inherit",
    "permissions": "prompt"
  },
  "theme": {
    "name": "opencode",
    "mode": "system"
  },
  "tabs": {
    "layout": "vertical",
    "indicators": "status"
  },
  "animations": true,
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "image_preview": true,
    "paste": "full"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "debug": {
    "devtools": true,
    "turn_tokens": false
  },
  "diffs": {
    "view": "split",
    "single": false
  }
}
