{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "yerd": {
        "type": "local",
        "command": ["yerd", "mcp"]
      }
    }
  },
  "plugin": [
    "@slkiser/opencode-quota@latest"
  ],
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    }
  ],
  "provider": {
    "openai": {}
  }
}
