DotConfig(
    dependencies: [
        Cargo(name: "starship"),
        Cargo(name: "exa", windows: false),
        Cargo(name: "ripgrep"),
        Cargo(name: "ru"),
        Cargo(name: "cargo-update"),
        Bash(name: "codex", command: "curl -fsSL https://chatgpt.com/codex/install.sh | sh", binary: Some("codex")),
        Bash(name: "bun", command: "curl -fsSL https://bun.sh/install | bash", binary: Some("bun")),
        Bash(name: "vite-plus", command: "curl -fsSL https://vite.plus | VP_NODE_MANAGER=yes VP_PM_MANAGER=no VP_PNPM_MANAGER=yes bash", binary: Some("vp")),
        Bash(name: "oh-my-zsh", command: "curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh | RUNZSH=no KEEP_ZSHRC=yes bash", directory: Some("%HOME%/.oh-my-zsh")),
    ],
    symlinks: [
        Location(
            from: "links/ZSH/zshrc",
            to: Os(
                macos: "%HOME%/.zshrc",
                linux: "%HOME%/.zshrc",
                windows: ""
            )
        ),
        Location(
            from: "links/.ideavimrc",
            to: String("%HOME%/.ideavimrc")
        ),
        Location(
            from: "links/zed",
            to: Os(
                macos: "%UNIX_CONFIG%/zed",
                linux: "%CONFIG%/zed",
                windows: "%DATA%/Zed"
            )
        ),
        Location(
            from: "links/ghostty",
            to: Os(
                macos: "%CONFIG%/com.mitchellh.ghostty",
                linux: "%UNIX_CONFIG%/ghostty",
                windows: ""
            )
        ),
        Location(
            from: "links/nvim",
            to: Os(
                macos: "%UNIX_CONFIG%/nvim",
                linux: "%CONFIG%/nvim",
                windows: "%DATA_LOCAL%/nvim"
            )
        ),
        Location(
            from: "links/Sublime/User",
            to: Os(
                macos: "%HOME%/Library/Application Support/Sublime Text/Packages/User",
                linux: "",
                windows: "",
            )
        ),
        Location(
            from: "links/starship/starship.toml",
            to: Os(
                macos: "%UNIX_CONFIG%/starship.toml",
                linux: "%CONFIG%/starship.toml",
                windows: "%HOME%/starship.toml"
            ),
        )
    ],
    copies: [
        Location(
            from: "links/Powershell",
            to: Os(
                macos: "",
                linux: "",
                windows: "%DOCUMENTS%/Powershell"
            )
        ),
        Location(
            from: "links/fonts",
            to: Os(
                macos: "%HOME%/Library/Fonts",
                linux: "%HOME%/.local/share/fonts",
                windows: "%DATA_LOCAL%/Microsoft/Windows/Fonts",
            )
        )
    ],
    git_aliases: [
        GitAlias(
            name: "st",
            command: "status",
        ),
        GitAlias(
            name: "co",
            command: "checkout",
        ),
        GitAlias(
            name: "ci",
            command: "commit",
        ),
    ],
)
